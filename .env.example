APP_NAME=My FastAPI App
ENVIRONMENT=development
DEBUG=true

# SQLAlchemy 2.x requires the `postgresql+driver://` form.
# A bare `postgres://` URL is rejected at engine creation.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/baton

# Signs the JWTs. There is no default: generate one per environment with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Changing it invalidates every token already issued.
JWT_SECRET_KEY=replace-me-with-a-generated-secret
JWT_ALGORITHM=HS256

# The access token is short because it is what every request carries.
# The refresh token is what keeps a sign-in alive, and its window slides:
# every refresh pushes it out again, so this is an idle timeout rather
# than a fixed date.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# How long a workspace invitation link stays usable. Default is one week.
INVITATION_EXPIRE_HOURS=168

# Two days to confirm an address; an hour to use a reset link. The second
# is much shorter on purpose -- it is a key to the account.
EMAIL_VERIFICATION_EXPIRE_HOURS=48
PASSWORD_RESET_EXPIRE_MINUTES=60

# Where the links in those emails point: the dashboard, not this API.
# Left unset the email carries the bare token instead, which is enough to
# work with locally. Required in production.
FRONTEND_BASE_URL=http://localhost:3000

# Delivering those emails. Leave SMTP_HOST unset locally and the whole
# message, link included, is written to the log instead -- which is why
# production refuses to start without a real one. SMTP_USE_TLS=false is
# for a local catch-all mail trap and nothing else.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=

# Rate limiting, counted per worker in memory. Every number is an
# allowance and a burst at once: ten a minute means ten straight away and
# then one every six seconds. Running four workers allows four times each
# of these -- see the README for when that stops being the right trade.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_EMAIL_PER_HOUR=5
RATE_LIMIT_INVITATIONS_PER_HOUR=60
RATE_LIMIT_AI_PER_MINUTE=60
RATE_LIMIT_SEARCH_PER_MINUTE=60
RATE_LIMIT_UPLOADS_PER_HOUR=120
RATE_LIMIT_WEBHOOK_REJECTIONS_PER_MINUTE=30

# Where this API answers, as the outside world reaches it. Needed for the
# Shopify OAuth redirect, which has to be an absolute URL.
API_BASE_URL=http://localhost:8000

# Installing a Shopify storefront. Read-only scopes on purpose: this
# product answers questions about a catalogue, it does not edit one.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,read_orders,read_customers

# Installing a WooCommerce store needs no credentials of ours -- its auth
# endpoint hands the keys over. Its webhooks are signed with a secret
# whoever creates the webhook types into a form, so this is the one to
# publish and ask for. Without it, no WooCommerce delivery verifies.
WOOCOMMERCE_WEBHOOK_SECRET=

# Taking the money. Optional: a deployment that is not selling anything
# works without it and every workspace is on the free plan. The price
# identifiers are Stripe's names for what a plan costs and differ between
# test and live mode, which is why they are configuration rather than a
# fact in app/services/plans.py.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_BUSINESS=

# Encrypts provider access tokens before they are stored. Optional in
# development and required in production. Generate one per environment:
#   uv run python -c \
#     "from app.core.encryption import generate_key as k; import sys; \
#      sys.stdout.write(k())"
# Changing it makes every token already stored undecryptable.
ENCRYPTION_KEY=

# One Meta app receives the webhooks for every workspace, so both of these
# are app-wide rather than per workspace. The verify token is a string you
# choose and repeat in Meta's webhook setup; the app secret is the one
# Meta shows on the app's settings page, and it signs every delivery.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Turns a business's knowledge into vectors, and a customer's question
# into one to compare against them. Without it the knowledge base refuses
# uploads with a clear error; everything else works.
# Changing the model or the dimensions invalidates every vector already
# stored -- two vectors of different lengths cannot be compared -- so a
# change to either means re-ingesting every document.
VOYAGE_API_KEY=
# EMBEDDING_MODEL=voyage-3.5-lite
# EMBEDDING_DIMENSIONS=1024

# Writes the assistant's replies. Without it the AI endpoints answer
# `failed` and the inbox carries on working exactly as it did.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_MAX_TOKENS=1024

# Origins a browser client may call this API from, comma separated.
# Empty means no cross-origin requests are accepted at all.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

# Host header values the API answers to. "*" is fine behind a proxy that
# already validates it; production must name real hosts.
ALLOWED_HOSTS=*

LOG_LEVEL=INFO

# "text" reads better in a terminal, "json" is what a log aggregator can
# query. Left unset it follows ENVIRONMENT: text in development, json
# everywhere else.
# LOG_FORMAT=text
